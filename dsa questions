#include <iostream>
#include <iomanip>

using namespace std;


int main(){
    double amount;
    cout<< "enter the amount : ";
    cin >> amount;
    
    double finalAmount;
    if(amount < 1000){
        finalAmount = amount - (amount * 0.05);
    }else if(amount >= 1000 and amount < 5000){
          finalAmount = amount - (amount * 0.1);
    }else{
        finalAmount = amount - (amount * 0.15);
    }
    
    cout<< fixed << setprecision(2) << finalAmount;
    
    
    return 0;
}

