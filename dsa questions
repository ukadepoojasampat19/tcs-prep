3) You are given n transactions. Each transaction has:

sender
receiver
amount
timestamp

A transaction is fraudulent if:

sender, receiver, and amount are the same.
The timestamp difference is <= 60 seconds.

Print all fraudulent transactions.


------------------------------------------------------------------------------------------------------------------------------------------------------------
#include <bits/stdc++.h>
using namespace std;

struct Transaction {
    string sender, receiver;
    double amount;
    long long time;
};

int main() {
    int n;
    cin >> n;

    vector<Transaction> t(n);

    // Input transactions
    for (int i = 0; i < n; i++) {
        cin >> t[i].sender >> t[i].receiver >> t[i].amount >> t[i].time;
    }

    vector<bool> fraud(n, false);

    // Check for duplicate transactions within 60 seconds
    for (int i = 0; i < n; i++) {
        for (int j = i + 1; j < n; j++) {
            if (t[i].sender == t[j].sender &&
                t[i].receiver == t[j].receiver &&
                t[i].amount == t[j].amount &&
                abs(t[i].time - t[j].time) <= 60) {

                fraud[i] = true;
                fraud[j] = true;
            }
        }
    }

    // Print fraudulent transactions
    cout << "Fraudulent Transactions:\n";

    bool found = false;
    for (int i = 0; i < n; i++) {
        if (fraud[i]) {
            found = true;
            cout << t[i].sender << " "
                 << t[i].receiver << " "
                 << t[i].amount << " "
                 << t[i].time << "\n";
        }
    }

    if (!found) {
        cout << "No fraudulent transactions found.\n";
    }

    return 0;
}

